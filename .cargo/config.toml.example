# Local development against a sibling AQL checkout (../AQL), including AQL
# changes that are not pushed yet. Copy to .cargo/config.toml (gitignored).
[patch."https://github.com/a3t-ai/AQL.git"]
aql-parser = { path = "../AQL/crates/aql-parser" }

# Local development against a sibling A3T checkout (../A3T): FlowR's engine store.
[patch."https://github.com/a3t-ai/A3T.git"]
flowr-storage = { path = "../A3T/shared/flowr-storage" }
